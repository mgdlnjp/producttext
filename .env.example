# --- ProductText : variables d'environnement SERVEUR uniquement ---
# Ne jamais préfixer ces variables par VITE_ : elles seraient exposées au navigateur.

# Clé API Anthropic (https://platform.claude.com). Laisser vide => mode démonstration.
ANTHROPIC_API_KEY=

# Modèle Claude utilisé (optionnel). Défaut : claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# Niveau d'effort : low (défaut, rapide et économique), medium ou high.
ANTHROPIC_EFFORT=low

# Port du serveur API (défaut : 8787)
PORT=8787

# --- Abonnement Stripe (facultatif) ---
# Sans STRIPE_SECRET_KEY et STRIPE_PRICE_ID, la facturation est désactivée et l'outil reste en accès libre.
STRIPE_SECRET_KEY=
# Prix récurrent du forfait Pro (dashboard.stripe.com → Catalogue de produits).
STRIPE_PRICE_ID=
# Secret de signature des jetons d'accès Pro, au moins 32 caractères : openssl rand -base64 48
ACCESS_TOKEN_SECRET=
# Origine publique de l'app pour les redirections Stripe (recommandé en production), sans / final.
APP_URL=
# Générations gratuites par IP sur 24 h glissantes.
FREE_USES_PER_DAY=3
